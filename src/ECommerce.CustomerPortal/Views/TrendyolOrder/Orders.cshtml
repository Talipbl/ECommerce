@section Header {
    <link href="~/plugins/datatable/css/datatable.css" rel="stylesheet" />
    <link href="~/plugins/datatable/css/datatable-bootstrap.min.css" rel="stylesheet" />
    <style>
        .btn.btn-social-icon {
            width: 30px;
            height: 30px;
            padding: 0;
        }
    </style>
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Tüm Siparişler</h4>
            <p class="card-description">
                Trendyol üzerinde bulunan tüm ürünler.
            </p>
            <div class="table-responsive">
                <table id="orders" class="table table-bordered">
                    <thead>
                        <tr>
                            <th>
                                <div class="form-check form-check-success">
                                    <label class="form-check-label">
                                        <input type="checkbox" class="form-check-input select-all">
                                    </label>
                                </div>
                            </th>
                            <th style="width:125px">Sipariş Numarası</th>
                            <th>Müşteri Adı</th>
                            <th style="width:125px">Müşteri Soyadı</th>
                            <th>Toplam Fiyat</th>
                            <th style="width:125px">Durumu</th>
                            <th style="width:125px">Kargo Firması</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Script {
    <script src="~/plugins/datatables.net/datatables.min.js"></script>
    <script src="~/source/extensions.js"></script>
    <script type="module" src="~/source/trendyol/order.js"></script>
}