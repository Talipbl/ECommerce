@model List<DefCategory>
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<div class="content-wrapper">
    <div class="col-12 p-5 row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex p-0">
                    <h3 class="card-title p-3">Ürün Ekleme</h3>
                </div>
                <div class="card-body">
                    A wonderful serenity has taken possession of my entire soul,
                    like these sweet mornings of spring which I enjoy with my whole heart.
                    I am alone, and feel the charm of existence in this spot,
                    which was created for the bliss of souls like mine. I am so happy,
                    my dear friend, so absorbed in the exquisite sense of mere tranquil existence,
                    that I neglect my talents. I should be incapable of drawing a single stroke
                    at the present moment; and yet I feel that I never was a greater artist than now.
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="collapse" id="collapseErrors">
                <div class="callout callout-danger" role="alert">
                    <div class="m-alert__icon">
                        <i class="la la-warning"></i>
                    </div>
                    <div class="m-alert__text" id="errors">
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 col-sm-12">
            <div class="card card-primary card-outline card-outline-tabs">
                <div class="card-header p-0 border-bottom-0">
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md col-sm-12">
                            <!-- Select multiple-->
                            <div class="form-group">
                                <label>Ana Kategori</label>
                                <select id="main-category" multiple class="form-control" size="10">
                                    @foreach (var item in Model)
                                    {
                                        <option value="@item.Id">@item.CategoryName</option>
                                    }
                                </select>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-success btn-flat add-main">Ekle</button>
                                    </div>
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-primary btn-flat">Düzenle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md col-sm-12">
                            <!-- Select multiple-->
                            <div id="div-1-category" class="form-group">
                                <label>1. Alt Kategori</label>
                                <select disabled id="sub-1-category" multiple class="form-control" size="10">
                                </select>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-success btn-flat sub-1-btn add-sub">Ekle</button>
                                    </div>
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-primary btn-flat sub-1-btn">Düzenle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md col-sm-12">
                            <!-- Select multiple-->
                            <div id="div-2-category" class="form-group">
                                <label>2. Alt Kategori</label>
                                <select disabled id="sub-2-category" multiple class="form-control" size="10">
                                </select>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-success btn-flat sub-2-btn add-sub">Ekle</button>
                                    </div>
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-primary btn-flat sub-2-btn">Düzenle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md col-sm-12">
                            <!-- Select multiple-->
                            <div id="div-3-category" class="form-group">
                                <label>3. Alt Kategori</label>
                                <select disabled id="sub-3-category" multiple class="form-control" size="10">
                                </select>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-success btn-flat sub-3-btn add-sub">Ekle</button>
                                    </div>
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-primary btn-flat sub-3-btn">Düzenle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md col-sm-12">
                            <!-- Select multiple-->
                            <div id="div-4-category" class="form-group">
                                <label>4. Alt Kategori</label>
                                <select disabled id="sub-4-category" multiple class="form-control" size="10">
                                </select>
                                <div class="row mt-1">
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-success btn-flat sub-4-btn add-sub">Ekle</button>
                                    </div>
                                    <div class="col-6">
                                        <button hidden type="button" class="btn btn-sm btn-block btn-primary btn-flat sub-4-btn">Düzenle</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="add-sub-modal">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Small Modal</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <label>Ad</label>
                <input type="text" class="form-control" id="categoryName" name="MinimumOrder" placeholder="Kategori Adı:">
                <hr />
                <label>Açıklama</label>
                <input type="text" class="form-control" id="categoryDesc" name="MinimumOrder" placeholder="Kategori Açıklaması:">
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-primary" onclick="addSub()">Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Script{
    <script src="~/js/libs/category/category.js" type="module"></script>
    }
