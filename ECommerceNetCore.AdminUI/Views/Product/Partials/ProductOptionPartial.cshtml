@{
    Layout = null;
}

<div class="card card-warning card-outline">
    <form id="option-form">
        <div class="card-body">
            <div class="col-12">
                <div class="col-md-12 col-sm-12 row">
                    <div class="col-md-12 col-sm-12 row">
                        <div class="col-sm-12">
                            <div class="form-group">
                                <label>Genel Bilgileri</label>
                                <hr />
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="form-group">
                                <label>Varyasyon Adı</label>
                                <input type="text" class="form-control" id="option-name" name="OptionName" placeholder="Ürün seçeneğinin adı">
                                <code>Maximum 200 karakter</code>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="form-group">
                                <label>Stok Kodu</label>
                                <input type="text" class="form-control" id="stock-code" name="StockCode" placeholder="Stok kodu">
                                <code>Maximum 15 karakter<br />Türkçe ve özel karakter içermemeli!</code>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-12">
                            <div class="form-group">
                                <label for="brand">Durumu</label>
                                <select class="form-control" id="status" name="StatusId" style="width: 100%;">
                                    <option value="1" selected>Aktif</option>
                                    <option value="2">Pasif</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="col-12">
                        <div class="form-group">
                            <label>Fiyat Bilgisi</label>
                            <hr />
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-12">
                        <div class="col-md-12 col-sm-12 row">
                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label>Fiyat</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <select class="form-control" id="currency" name="CurrencyId" style="width: 100%; border-top-right-radius: 0px;border-bottom-right-radius: 0px;">
                                                <option value="1" selected>₺ TL</option>
                                                <option value="2">$ USD</option>
                                                <option value="3">€ EUR</option>
                                            </select>
                                        </div>
                                        <input type="text" class="form-control" id="price" name="Price" placeholder="Fiyatı">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="form-group">
                                    <label>Maliyet</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-money-bill"></i></span>
                                        </div>
                                        <input type="text" class="form-control" id="purchase-price" name="PurchasePrice" placeholder="Maliyeti">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-4">
                                <div class="form-group">
                                    <label>Vergi Oranı</label>
                                    <select class="form-control" id="currency" name="VatRatioId" style="width: 100%;">
                                        <option value="1" selected>% 1</option>
                                        <option value="2">% 8</option>
                                        <option value="3">% 18</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12 col-sm-12 row">
                            <div class="col-md-3 col-sm-6">
                                <div class="form-group">
                                    <label>İndirimli Fiyatı</label>
                                    <input type="text" class="form-control" id="discount-price" name="DiscountPrice">
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="form-group">
                                    <label>İndirim Oranı</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">%</span>
                                        </div>
                                        <input type="text" class="form-control" id="discount-ratio" name="DiscountRatio">
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label>İndirim Bitiş Tarihi</label>
                                    <div class="input-group date" data-target-input="nearest">
                                        <input readonly type="text" name="DiscountExpireDate" class="form-control datetimepicker-input" />
                                        <div class="input-group-append" data-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6 p-4">
                                <div class="form-check-inline">
                                    <div class="icheck-primary">
                                        <input type="checkbox" name="IsSale">
                                        <label>İndirimdeki Ürün</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <hr />
                    <div class="col-12">
                        <div class="form-group">
                            <label>Ürün Bilgisi</label>
                            <hr />
                        </div>
                    </div>
                    <div class="col-md-12 col-sm-12">
                        <div class="col-md-12 col-sm-12 row">
                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label for="brand">Stok Birimi</label>
                                    <select class="form-control" id="unit-typpe" name="UnitTypeId" style="width: 100%;">
                                        <option value="1" selected="selected">Adet</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label>Stok Miktarı</label>
                                    <input type="text" class="form-control" id="unit-stock" name="UnitOfStock" placeholder="Stok Miktarı">
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-12">
                                <div class="form-group">
                                    <label>Stoğa Girme Tarihi</label>
                                    <div class="input-group date" data-target-input="nearest">
                                        <input readonly type="text" name="AvailableDate" class="form-control datetimepicker-input" />
                                        <div class="input-group-append" data-toggle="datetimepicker">
                                            <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6 p-4">
                                <div class="form-check-inline">
                                    <div class="icheck-primary">
                                        <input type="checkbox" name="IsAvailable">
                                        <label>Stokta Var</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <hr />
                        <div class="col-md-12 col-sm-12 row">
                            <div class="col-md-3 col-sm-6">
                                <div class="form-group">
                                    <label for="brand">Uzunluk Birimi</label>
                                    <select class="form-control" id="length-typpe" name="LengthTypeId" style="width: 100%;">
                                        <option value="1" selected="selected">Santimetre</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-3 col-sm-6">
                                <div class="form-group">
                                    <label>Uzunluk</label>
                                    <input type="text" class="form-control" id="length" name="Length" placeholder="Uzunluk">
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <div class="form-group">
                                    <label>Yükseklik</label>
                                    <input type="text" class="form-control" id="height" name="Height" placeholder="Yükseklik">
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <div class="form-group">
                                    <label>Genişlik</label>
                                    <input type="text" class="form-control" id="width" name="Width" placeholder="Genişlik">
                                </div>
                            </div>
                            <div class="col-md-2 col-sm-6">
                                <div class="form-group">
                                    <label>Ağırlık</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">gr</span>
                                        </div>
                                        <input type="text" class="form-control" id="weight" name="Weight" placeholder="Ağırlık">
                                    </div>
                                </div>
                            </div>
                            <hr />
                        </div>
                    </div>
                </div>
                <div class="col-md-12 col-sm-12">
                    <div class="col-12">
                        <div class="form-group">
                            <label>Görselleri</label>
                            <hr />
                        </div>
                    </div>
                    <div class="input-group">
                        <div class="custom-file">
                            <input type="file" class="custom-file-input" id="exampleInputFile">
                            <label class="custom-file-label" for="exampleInputFile">Choose file</label>
                        </div>
                    </div>
                    <div class="col-12 row" id="option-images">
                    </div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="col-12" style="display:flex; justify-content:end">
                <button type="button" id="btn-remove" onclick="remove(this)" class="btn btn-danger">Kaldır</button>
            </div>
        </div>
    </form>
</div>