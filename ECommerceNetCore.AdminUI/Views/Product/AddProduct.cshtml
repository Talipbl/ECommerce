@model ProductModifyModel
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

@section Header{
    <link rel="stylesheet" href="~/plugins/summernote/summernote-bs4.min.css">
    <link rel="stylesheet" href="~/plugins/ekko-lightbox/ekko-lightbox.css">
}

<div class="content-wrapper">
    <div class="col-12 p-5 row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex p-0">
                    <h3 class="card-title p-3">Ürün Ekleme</h3>
                </div>
                <div class="card-body">
                    A wonderful serenity has taken possession of my entire soul,
                    like these sweet mornings of spring which I enjoy with my whole heart.
                    I am alone, and feel the charm of existence in this spot,
                    which was created for the bliss of souls like mine. I am so happy,
                    my dear friend, so absorbed in the exquisite sense of mere tranquil existence,
                    that I neglect my talents. I should be incapable of drawing a single stroke
                    at the present moment; and yet I feel that I never was a greater artist than now.
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="collapse" id="collapseErrors">
                <div class="callout callout-danger" role="alert">
                    <div class="m-alert__icon">
                        <i class="la la-warning"></i>
                    </div>
                    <div class="m-alert__text" id="errors">
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-9 col-sm-12">
            <div class="card card-primary card-outline card-outline-tabs">
                <div class="card-header p-0 border-bottom-0">
                    <ul class="nav nav-tabs" id="custom-tabs-four-tab" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="general-tab" data-toggle="pill" href="#general" role="tab" aria-controls="general" aria-selected="true">Genel Bilgiler</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="productOption-tab" data-toggle="pill" href="#productOption" role="tab" aria-controls="productOption" aria-selected="false">Ürün Varyasyonları</a>
                        </li>
                    </ul>
                </div>
                <div class="card-body">
                    <div class="tab-content" id="custom-tabs-four-tabContent">
                        <div class="tab-pane fade show active" id="general" role="tabpanel" aria-labelledby="general-tab">
                            <form id="product-form">
                                <div class="col-12 p-2">
                                    <div class="col-12 row">
                                        <div class="col-md-6 col-sm-12">
                                            <div class="form-group">
                                                <label>Ürün Adı</label>
                                                <input type="text" class="form-control" id="name1" name="Name" placeholder="Ürünün görüntüleneceği adını giriniz.">
                                                <code>Maximum 100 karakter</code>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-12">
                                            <div class="form-group">
                                                <label>Ürün Markası</label>
                                                <select class="form-control select2" id="brand" name="BrandId" style="width: 100%;">
                                                    <option value="0" selected="selected">Seçiniz</option>
                                                    @foreach (var brand in Model.Brands)
                                                    {
                                                        <option value="@brand.Id">@brand.BrandName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-3 col-sm-12">
                                            <div class="form-group">
                                                <label>Ürün Üreticisi</label>
                                                <select class="form-control select2" id="manufacturer" name="ManufacturerId" style="width: 100%;">
                                                    @foreach (var manufacturer in Model.Manufacturers)
                                                    {
                                                        <option value="@manufacturer.Id">@manufacturer.ManufacturersName</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>Ürün Açıklaması</label>
                                            <textarea rows="16" class="form-control" id="description" name="Description" placeholder="Ürün hakkında gerekli bilgiyi bu alanda vereceksiniz. Ürünün açıklaması, özellikleri, kullanım alanları gibi kullanıcıyı bilgilendirecek tüm içeriği buraya giriniz."></textarea>
                                            <code>HTML öğeleri içerebilir</code><br />
                                            <code>Maximum 4000 karakter</code>
                                        </div>
                                    </div>
                                    <div class="col-md-12 col-sm-12">
                                        <div class="col-12 row">
                                            <div class="col-md-4 col-sm-12">
                                                <div class="form-group">
                                                    <label>Satıcı Ürün Kodu</label>
                                                    <input type="text" class="form-control" id="sellerCode" name="SellerCode" placeholder="Xml servisinde kullanılan ürün kodu">
                                                </div>
                                                <div class="form-group">
                                                    <label>Minimum Sipariş Miktarı</label>
                                                    <input type="text" class="form-control" id="sellerCode" name="MinimumOrder" placeholder="Müşteri için minium sipariş adedi">
                                                </div>
                                                <div class="form-group">
                                                    <label>Satıcı URL</label>
                                                    <input type="text" class="form-control" id="sellerUrl" name="SellerUrl" placeholder="Xml servisinde kullanılan satıcı adresi">
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-12">
                                                <div class="form-group">
                                                    <label>UPC</label>
                                                    <input type="text" class="form-control" id="upc" name="Upc" placeholder="Evrensel Ürün Kodu">
                                                </div>
                                                <div class="form-group">
                                                    <label>JAN</label>
                                                    <input type="text" class="form-control" id="jan" name="Jan" placeholder="Japon Ürün Numarası">
                                                </div>
                                                <div class="form-group">
                                                    <label>MPN</label>
                                                    <input type="text" class="form-control" id="mpn" name="Mpn" placeholder="Üretici Parça Numarası">
                                                </div>
                                            </div>
                                            <div class="col-md-4 col-sm-12">
                                                <div class="form-group">
                                                    <label>EAN</label>
                                                    <input type="text" class="form-control" id="ean" name="Ean" placeholder="Uluslararası Ürün Numarası">
                                                </div>
                                                <div class="form-group">
                                                    <label>ISBN</label>
                                                    <input type="text" class="form-control" id="isbn" name="Isbn" placeholder="Uluslararası Kitap Numarası">
                                                </div>
                                                <div class="form-group">
                                                    <label>Stok Kodu</label>
                                                    <input type="text" class="form-control" id="stock-code" name="StockCode" placeholder="Stok kodu">
                                                    <code>Maximum 15 karakter<br />Türkçe ve özel karakter içermemeli!</code>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <div class="tab-pane fade" id="category" role="tabpanel" aria-labelledby="category-tab">
                        </div>
                        <div class="tab-pane fade" id="productOption" role="tabpanel" aria-labelledby="productOption-tab">
                            <div class="col-12 row">
                                <div class="col-12">
                                    <div class="card">
                                        <div class="card-body">
                                            <div class="col-12 row">
                                                <div class="col">
                                                    A wonderful serenity has taken possession of my entire soul,
                                                    like these sweet mornings of spring which I enjoy with my whole heart.
                                                </div>
                                                <div style="display:flex; justify-content:end">
                                                    <button type="button" id="btn-add-option" class="btn btn-primary">Ekle</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12" id="options-section">
                                    <div class="card card-warning card-outline">
                                        <form id="option-form">
                                            <div class="card-body">
                                                <div class="col-12">
                                                    <div class="col-md-12 col-sm-12 row">
                                                        <div class="col-md-12 col-sm-12 row">
                                                            <div class="col-sm-12">
                                                                <div class="form-group">
                                                                    <label>Genel Bilgileri</label>
                                                                    <hr />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4 col-sm-12">
                                                                <div class="form-group">
                                                                    <label>Varyasyon Adı</label>
                                                                    <input type="text" class="form-control" id="option-name" name="OptionName" placeholder="Ürün seçeneğinin adı">
                                                                    <code>Maximum 50 karakter</code>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4 col-sm-12">
                                                                <div class="form-group">
                                                                    <label>Stok Kodu</label>
                                                                    <input type="text" class="form-control" id="stock-code" name="StockCode" placeholder="Stok kodu">
                                                                    <code>Maximum 15 karakter<br />Türkçe ve özel karakter içermemeli!</code>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-4 col-sm-12">
                                                                <div class="form-group">
                                                                    <label for="brand">Durumu</label>
                                                                    <select class="form-control" id="status" name="StatusId" style="width: 100%;">
                                                                        @foreach (var statu in Model.Status)
                                                                        {
                                                                            <option value="@statu.Id">@statu.StatusName</option>
                                                                        }
                                                                    </select>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <hr />
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label>Fiyat Bilgisi</label>
                                                                <hr />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12">
                                                            <div class="col-md-12 col-sm-12 row">
                                                                <div class="col-md-3 col-sm-12">
                                                                    <div class="form-group">
                                                                        <label>Fiyat</label>
                                                                        <div class="input-group">
                                                                            <div class="input-group-prepend">
                                                                                <select class="form-control" id="currency" name="CurrencyId" style="width: 100%; border-top-right-radius: 0px;border-bottom-right-radius: 0px;">
                                                                                    @foreach (var currency in Model.Currencies)
                                                                                    {
                                                                                        <option value="@currency.Id">@currency.Icon</option>
                                                                                    }
                                                                                </select>
                                                                            </div>
                                                                            <input type="text" class="form-control" id="price" name="Price" placeholder="Fiyatı">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>Maliyet</label>
                                                                        <div class="input-group">
                                                                            <div class="input-group-prepend">
                                                                                <span class="input-group-text"><i class="fas fa-money-bill"></i></span>
                                                                            </div>
                                                                            <input type="text" class="form-control" id="purchase-price" name="PurchasePrice" placeholder="Maliyeti">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2 col-sm-4">
                                                                    <div class="form-group">
                                                                        <label>Vergi Oranı</label>
                                                                        <select class="form-control" id="currency" name="VatRatioId" style="width: 100%;">
                                                                            @foreach (var vat in Model.VatRatios)
                                                                            {
                                                                                <option value="@vat.Id">% @vat.VatRatioValue</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-12 col-sm-12 row">
                                                                <div class="col-md-3 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>İndirimli Fiyatı</label>
                                                                        <input type="text" class="form-control" id="discount-price" name="DiscountPrice">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>İndirim Oranı</label>
                                                                        <div class="input-group">
                                                                            <div class="input-group-prepend">
                                                                                <span class="input-group-text">%</span>
                                                                            </div>
                                                                            <input type="text" class="form-control" id="discount-ratio" name="DiscountRatio">
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-12">
                                                                    <div class="form-group">
                                                                        <label>İndirim Bitiş Tarihi</label>
                                                                        <div class="input-group date discount" id="discountdatetime" data-target-input="nearest">
                                                                            <input readonly type="text" name="DiscountExpireDate" class="form-control datetimepicker-input" data-target="#discountdatetime" />
                                                                            <div class="input-group-append" data-target="#discountdatetime" data-toggle="datetimepicker">
                                                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-6 p-4">
                                                                    <div class="form-check-inline">
                                                                        <div class="icheck-primary">
                                                                            <input type="checkbox" id="is-sale" name="IsSale">
                                                                            <label for="is-sale">İndirimdeki Ürün</label>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <hr />
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label>Ürün Bilgisi</label>
                                                                <hr />
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12">
                                                            <div class="col-md-12 col-sm-12 row">
                                                                <div class="col-md-3 col-sm-12">
                                                                    <div class="form-group">
                                                                        <label for="brand">Stok Birimi</label>
                                                                        <select class="form-control" id="unit-typpe" name="UnitTypeId" style="width: 100%;">
                                                                            @foreach (var unit in Model.UnitTypes)
                                                                            {
                                                                                <option value="@unit.Id">@unit.TypeName</option>
                                                                            }
                                                                        </select>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-12">
                                                                    <div class="form-group">
                                                                        <label>Stok Miktarı</label>
                                                                        <input type="text" class="form-control" id="unit-stock" name="UnitOfStock" placeholder="Stok Miktarı">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-12">
                                                                    <div class="form-group">
                                                                        <label>Stoğa Girme Tarihi</label>
                                                                        <div class="input-group date available" id="availabledatetime" data-target-input="nearest">
                                                                            <input readonly type="text" name="AvailableDate" class="form-control datetimepicker-input" data-target="#availabledatetime" />
                                                                            <div class="input-group-append" data-target="#availabledatetime" data-toggle="datetimepicker">
                                                                                <div class="input-group-text"><i class="fa fa-calendar"></i></div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-3 col-sm-6 p-4">
                                                                    <div class="form-check-inline">
                                                                        <div class="icheck-primary">
                                                                            <input type="checkbox" id="is-available" name="IsAvailable">
                                                                            <label for="is-available">Stokta Var</label>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <hr />
                                                            <div class="col-md-12 col-sm-12 row">
                                                                <div class="col-md-3 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>Uzunluk</label>
                                                                        <input type="text" class="form-control" id="length" name="Length" placeholder="Uzunluk">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>Yükseklik</label>
                                                                        <input type="text" class="form-control" id="height" name="Height" placeholder="Yükseklik">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>Genişlik</label>
                                                                        <input type="text" class="form-control" id="width" name="Width" placeholder="Genişlik">
                                                                    </div>
                                                                </div>
                                                                <div class="col-md-2 col-sm-6">
                                                                    <div class="form-group">
                                                                        <label>Ağırlık</label>
                                                                        <div class="input-group">
                                                                            <input type="text" class="form-control" id="weight" name="Weight" placeholder="Ağırlık">
                                                                            <div class="input-group-append">
                                                                                <span class="input-group-text">gr</span>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <hr />
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="col-md-12 col-sm-12">
                                                        <div class="col-12">
                                                            <div class="form-group">
                                                                <label>Görselleri</label>
                                                                <hr />
                                                            </div>
                                                        </div>
                                                        <div class="input-group">
                                                            <div class="custom-file">
                                                                <input type="file" class="custom-file-input" id="exampleInputFile">
                                                                <label class="custom-file-label" for="exampleInputFile">Choose file</label>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 row" id="option-images">
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-12">
            <div class="mb-3">
                <button type="button" id="btn-complete" class="btn bg-gradient-success btn-block">Kaydı Tamamla</button>
            </div>
            <div class="card card-info card-outline">
                <div class="card-header p-0 border-bottom-0">
                    <h3 class="card-title text-bold p-3">Kategori Bilgisi</h3>
                </div>
                <div class="card-body">
                    <form id="category-form">
                        <div class="col-12">
                            <div class="col-12">
                                <div class="form-group">
                                    <label>Ana Kategori</label>
                                    <select class="form-control select2 col-12" id="main-category" name="CategoryId" style="width: 100%;">
                                        <option value="0" selected>Seçiniz</option>
                                        @foreach (var category in Model.Categories)
                                        {
                                            <option value="@category.Id">@category.CategoryName</option>
                                        }
                                    </select>
                                    <div class="col-12" style="display:flex; justify-content:center;">
                                        <i class="fa fa-long-arrow-alt-down mt-3"></i>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-group p-0">
                                    <label>Alt Kategori</label>
                                    <select disabled class="form-control select2" id="sub-category" name="SubCategoryId" style="width: 100%;">
                                        <option value="0" selected>Seçiniz</option>
                                    </select>
                                </div>
                                <div class="form-group" id="sub-categories">
                                </div>
                                <button disabled type="button" id="btn-add-category" class="btn bg-gradient-primary">Alt Kategori Ekle</button>
                                <button hidden type="button" id="btn-remove-category" class="btn bg-gradient-danger">Alt Kategori Kaldır</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Script{
    @*Modules*@
    <script src="~/plugins/bs-custom-file-input/bs-custom-file-input.min.js"></script>
    <script src="~/plugins/summernote/summernote-bs4.min.js"></script>
    <script src="~/plugins/ekko-lightbox/ekko-lightbox.min.js"></script>
    <script src="~/js/libs/products.js" type="module"></script>
}