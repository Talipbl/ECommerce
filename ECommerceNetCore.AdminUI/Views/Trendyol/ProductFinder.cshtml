@{
    ViewData["Title"] = "Trendyol Ürün Bulucu";
}

@section Header{
    <link rel="stylesheet" href="~/plugins/ekko-lightbox/ekko-lightbox.css">
    <link rel="stylesheet" href="~/plugins/toastr/toastr.min.css">
}

<div class="content-wrapper">
    <div class="col-12 p-5 row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex p-0">
                    <h3 class="card-title p-3">Ürün Bulucu</h3>
                </div>
                <div class="card-body">
                    <label>
                        A wonderful serenity has taken possession of my entire soul,
                        like these sweet mornings of spring which I enjoy with my whole heart.
                        I am alone, and feel the charm of existence in this spot,
                        which was created for the bliss of souls like mine. I am so happy,
                        my dear friend, so absorbed in the exquisite sense of mere tranquil existence,
                        that I neglect my talents. I should be incapable of drawing a single stroke
                        at the present moment; and yet I feel that I never was a greater artist than now.
                    </label>
                    <div class="col-12 row mt-3">
                        <div class="col-md-11">
                            <input type="text" class="form-control" id="search-url" placeholder="Aranacak Trendyol linki...">
                        </div>
                        <div class="col-md-1">
                            <button onclick="search(1);" class="btn btn-block btn-primary">Ara</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex p-3">
                    <a href="javascript:;" onclick="bulkAddTy();" class="btn btn-warning mr-3">Trendyol</a>
                    <a href="#" class="btn btn-primary mr-3">Hepsiburada</a>
                    <a href="#" class="btn btn-info mr-3">n11</a>
                </div>
                <div class="card-body" id="products">
                    <div class="text-center">Arama yaparak başlayınız...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Script{
    <script src="~/plugins/ekko-lightbox/ekko-lightbox.min.js"></script>
    <script src="~/js/libs/trendyol/trendyol-crawler.js" type="module"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>
}