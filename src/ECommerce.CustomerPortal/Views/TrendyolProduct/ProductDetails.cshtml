@using Trendyol.Client
@model GetProductsResponseModel.ContentModel

@{
    ViewBag.Title = "Ürün Düzenle";
}

@section Header {
    <link href="~/plugins/select2/css/select2.min.css" rel="stylesheet" />
}

<div class="col-lg-12 grid-margin stretch-card">
    <div class="card">
        <div class="card-body">
            <h4 class="card-title">Ürün Düzenle - @Model.Title</h4>
            <form id="updateProductForm">
                <div class="row">
                    <div class="col-md-12">
                        <label for="title">Ürün Adı</label>
                        <input type="text" class="form-control" id="title" name="Title" value="@Model.Title">
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-4">
                        <label for="barcode">Barkod</label>
                        <input type="text" class="form-control" id="barcode" name="Barcode" value="@Model.Barcode" readonly disabled>
                    </div>
                    <div class="col-md-4">
                        <label for="productCode">Ürün Kodu</label>
                        <input type="text" class="form-control" id="productCode" name="ProductCode" value="@Model.ProductCode" readonly disabled>
                    </div>
                    <div class="col-md-4">
                        <label for="stockCode">Stok Kodu</label>
                        <input type="text" class="form-control" id="stockCode" name="StockCode" value="@Model.StockCode">
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <label for="brandId">Marka</label>
                        <input type="text" class="form-control" id="brandId" name="Brand" value="@Model.Brand" readonly disabled>
                    </div>
                    <div class="col-md-6">
                        <label for="categoryId">Kategori</label>
                        <select class="form-control" id="categoryName" name="CategoryName">
                            <option value="@Model.PimCategoryId">@Model.CategoryName</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-4">
                        <label for="listPrice">Liste Fiyatı</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-success text-black">₺</span>
                            </div>
                            <input type="number" step="0.01" class="form-control" id="listPrice" name="ListPrice" value="@Model.ListPrice.ToString().Replace(",",".")">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="salePrice">Satış Fiyatı</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text bg-success text-black">₺</span>
                            </div>
                            <input type="number" step="0.01" class="form-control" id="salePrice" name="SalePrice" value="@Model.SalePrice.ToString().Replace(",",".")">
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label for="vatRate">KDV Oranı</label>
                        <select class="form-control" id="vatRate" name="VatRate">
                            <option value="0" selected="@(Model.VatRate == 0)">0</option>
                            <option value="1" selected="@(Model.VatRate == 1)">1</option>
                            <option value="10" selected="@(Model.VatRate == 10)">10</option>
                            <option value="20" selected="@(Model.VatRate == 20)">20</option>
                        </select>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-6">
                        <label for="quantity">Stok Adedi</label>
                        <input type="number" class="form-control" id="quantity" name="Quantity" value="@Model.Quantity">
                    </div>
                    <div class="col-md-6">
                        <label for="deliveryDuration">Teslim Süresi</label>
                        <input type="number" class="form-control" id="deliveryDuration" name="DeliveryDuration" value="@Model.DeliveryDuration">
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <label for="description">Açıklama</label>
                        <textarea class="form-control" id="description" name="Description" rows="10" style="resize: vertical; height:150px">@Model.Description</textarea>
                    </div>
                </div>
                <div class="row mt-3">
                    <div class="col-md-12">
                        <label>Görseller</label>
                        <div class="d-flex flex-wrap" id="imageContainer">
                            @foreach (var image in Model.Images)
                            {
                                <div class="image-box m-2 position-relative">
                                    <button type="button" class="btn btn-danger btn-sm position-absolute" style="top: 5px; right: 5px;" onclick="remove(this, '@image.Url')">&times;</button>
                                    <img src="@image.Url" class="img-thumbnail" style="width: 100px; height: 100px; object-fit: cover;">
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="row mt-4">
                    <div class="col-md-12 text-center">
                        <button type="button" class="btn btn-primary" onclick="update()">Güncelle</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Script {
    <script src="~/plugins/select2/js/select2.min.js"></script>
    <script type="module" src="~/source/trendyol/product-detail.js"></script>
}
